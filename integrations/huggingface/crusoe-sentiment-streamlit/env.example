# ── OpenRouter (all 7 models via one key) ────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── Reddit ────────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crusoe-sentiment-bot/1.0 by /u/your_username

# ── Twitter / X (bearer token only needed for v2 search) ─────────────────────
TWITTER_BEARER_TOKEN=

# ── News (use one) ────────────────────────────────────────────────────────────
GNEWS_API_KEY=
NEWSAPI_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local: leave blank to use SQLite (crusoe_sentiment.db)
# Heroku: set automatically when you add heroku-postgresql addon
DATABASE_URL=

# ── Collection ────────────────────────────────────────────────────────────────
MAX_POSTS_PER_SOURCE=50

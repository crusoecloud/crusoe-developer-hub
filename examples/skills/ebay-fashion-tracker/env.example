# Copy to .env and fill in. .env is ignored by git; never commit real keys.
# Variables already set in your shell take priority over this file.

# --- Crusoe Managed Inference (required) -------------------------------------
# Create a key in the Crusoe Console: Intelligence Foundry > Inference > Create API Key.
CRUSOE_API_KEY=
CRUSOE_API_BASE=https://api.inference.crusoecloud.com/v1

# --- eBay developer keyset (required to search and track) --------------------
# developer.ebay.com > Application Keys > Production. A regular eBay buyer
# account is not enough; the keys come from the eBay Developers Program.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US
# ZIP code used for shipping estimates (optional).
EBAY_ZIP=

# --- Slack alerts (optional) -------------------------------------------------
# Bot token (xoxb-...) with the chat:write scope, and your own member ID (U...).
SLACK_BOT_TOKEN=
SLACK_USER_ID=

# --- Phone push through Pushover (optional) ----------------------------------
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- Heartbeat (optional) ----------------------------------------------------
# A URL that is requested after every fully successful poll.
EFT_HEARTBEAT_URL=

# --- Optional overrides ------------------------------------------------------
# Where the database and reference photos live.
# EFT_STATE_DIR=
# Local-time window in which only urgent alerts are sent.
# EFT_QUIET_HOURS=22:00-08:00
# Force a model for a role. Use the exact id returned by GET /v1/models.
# EFT_MODEL_VISION=
# EFT_MODEL_TEXT=
